@@ -0,0 +1,42 @@
+/**
+ * @file test_link_fault_recovery.cpp
+ * @brief Unit tests for REQ-LINK-006 faultCount and recoverFromFault.
+ */
+
+#include "link_state_machine.hpp"
+#include "test_framework.hpp"
+
+namespace can_fixture_test {
+
+namespace {
+
+using can_fixture::LinkConfig;
+using can_fixture::LinkState;
+using can_fixture::LinkStateMachine;
+
+/**
+ * @brief Verify faultCount tracking, recoverFromFault guards, and reset clearing.
+ * @req REQ-LINK-006
+ */
+void testFaultCountAndRecovery() {
+    const LinkConfig config{100U, 200U, 1U};
+    LinkStateMachine machine(config);
+    CHECK_EQ(machine.faultCount(), static_cast<std::uint32_t>(0U));
+    CHECK(!machine.recoverFromFault(10ULL));
+    CHECK(machine.startConnect(100ULL));
+    CHECK_EQ(machine.onTick(200ULL), LinkState::Connecting);
+    CHECK_EQ(machine.onTick(300ULL), LinkState::Fault);
+    CHECK_EQ(machine.faultCount(), static_cast<std::uint32_t>(1U));
+    CHECK(!machine.recoverFromFault(250ULL));
+    CHECK(machine.recoverFromFault(320ULL));
+    CHECK_EQ(machine.state(), LinkState::Connecting);
+    CHECK_EQ(machine.faultCount(), static_cast<std::uint32_t>(1U));
+    machine.reset();
+    CHECK_EQ(machine.faultCount(), static_cast<std::uint32_t>(0U));
+}
+
+}  // namespace
+
+REGISTER_TEST_SUITE(testFaultCountAndRecovery);
+
+}  // namespace can_fixture_test
