+bool FrameRingBuffer::popByCanId(std::uint32_t canId, CanFrame* frameOut) noexcept {
+    if (frameOut == nullptr || m_count == 0U) {
+        return false;
+    }
+    std::size_t foundOffset = m_count;
+    for (std::size_t i = 0U; i < m_count; ++i) {
+        const std::size_t idx = (m_tail + i) % m_capacity;
+        if (m_storage[idx].canId == canId) {
+            foundOffset = i;
+            break;
+        }
+    }
+    if (foundOffset >= m_count) {
+        return false;
+    }
+    const std::size_t matchIdx = (m_tail + foundOffset) % m_capacity;
+    *frameOut = m_storage[matchIdx];
+    for (std::size_t i = foundOffset; i + 1U < m_count; ++i) {
+        const std::size_t dstIdx = (m_tail + i) % m_capacity;
+        const std::size_t srcIdx = (m_tail + i + 1U) % m_capacity;
+        m_storage[dstIdx] = m_storage[srcIdx];
+    }
+    --m_count;
+    m_head = (m_tail + m_count) % m_capacity;
+    return true;
+}
