+/**
+ * @file test_ring_selective_pop.cpp
+ * @brief Unit tests for REQ-RING-005 FrameRingBuffer::popByCanId.
+ */
+
+#include "ring_buffer.hpp"
+#include "test_framework.hpp"
+
+namespace can_fixture_test {
+
+namespace {
+
+using can_fixture::CanFrame;
+using can_fixture::FrameRingBuffer;
+
+CanFrame makeSampleFrame(std::uint32_t canId, std::uint8_t tag) {
+    return CanFrame{canId, 8U, {tag, 0U, 0U, 0U, 0U, 0U, 0U, 0U}};
+}
+
+/**
+ * @brief Verify popByCanId handles non-match, first-match FIFO, and wrap-around.
+ * @req REQ-RING-005
+ */
+void testRingBufferPopByCanId() {
+    FrameRingBuffer ring(3U);
+    CanFrame out{0U, 0U, {0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U}};
+    CHECK(!ring.popByCanId(0x100U, &out));
+    CHECK(ring.push(makeSampleFrame(0x100U, 1U)));
+    CHECK(ring.push(makeSampleFrame(0x200U, 2U)));
+    CHECK(ring.push(makeSampleFrame(0x100U, 3U)));
+    CHECK(!ring.popByCanId(0x999U, &out));
+    CHECK(ring.pop(&out));
+    CHECK(ring.push(makeSampleFrame(0x300U, 4U)));
+    CHECK(ring.popByCanId(0x100U, &out));
+    CHECK_EQ(out.payload[0], static_cast<std::uint8_t>(3U));
+    CHECK_EQ(ring.size(), static_cast<std::size_t>(2U));
+    CHECK(ring.pop(&out));
+    CHECK_EQ(out.canId, 0x200U);
+    CHECK(ring.pop(&out));
+    CHECK_EQ(out.canId, 0x300U);
+}
+
+}  // namespace
+
+REGISTER_TEST_SUITE(testRingBufferPopByCanId);
+
+}  // namespace can_fixture_test
