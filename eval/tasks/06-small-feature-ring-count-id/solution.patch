+/**
+ * @brief Verify countByCanId counts matching frames across wrap-around without mutating state.
+ * @req REQ-RING-004
+ */
+void testRingBufferCountByCanId() {
+    FrameRingBuffer ring(3U);
+    CHECK_EQ(ring.countByCanId(0x100U), static_cast<std::size_t>(0U));
+
+    CHECK(ring.push(makeSampleFrame(0x100U, 1U)));
+    CHECK(ring.push(makeSampleFrame(0x200U, 2U)));
+    CHECK(ring.push(makeSampleFrame(0x100U, 3U)));
+    CHECK_EQ(ring.countByCanId(0x100U), static_cast<std::size_t>(2U));
+    CHECK_EQ(ring.countByCanId(0x200U), static_cast<std::size_t>(1U));
+    CHECK_EQ(ring.countByCanId(0x300U), static_cast<std::size_t>(0U));
+
+    CanFrame dequeued{0U, 0U, {0U, 0U, 0U, 0U, 0U, 0U, 0U, 0U}};
+    CHECK(ring.pop(&dequeued));
+    CHECK(ring.push(makeSampleFrame(0x100U, 4U)));
+    CHECK_EQ(ring.countByCanId(0x100U), static_cast<std::size_t>(2U));
+    CHECK_EQ(ring.size(), static_cast<std::size_t>(3U));
+}
+
 }  // namespace
 
