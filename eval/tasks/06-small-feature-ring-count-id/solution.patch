+std::size_t FrameRingBuffer::countByCanId(std::uint32_t canId) const noexcept {
+    std::size_t matches = 0U;
+    for (std::size_t i = 0U; i < m_count; ++i) {
+        const std::size_t slotIndex = (m_tail + i) % m_capacity;
+        if (m_storage[slotIndex].canId == canId) {
+            ++matches;
+        }
+    }
+    return matches;
+}
