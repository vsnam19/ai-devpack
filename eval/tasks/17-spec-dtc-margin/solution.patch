+std::int16_t DtcDebouncer::remainingToConfirm() const noexcept {
+    if (!isConfigValid() || m_isLatched || m_counter >= m_config.confirmThreshold) {
+        return 0;
+    }
+    const std::int32_t margin =
+        static_cast<std::int32_t>(m_config.confirmThreshold) - static_cast<std::int32_t>(m_counter);
+    return static_cast<std::int16_t>(margin);
