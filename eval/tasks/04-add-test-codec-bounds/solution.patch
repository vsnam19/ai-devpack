+/**
+ * @file test_codec_bounds.cpp
+ * @brief Unit tests for CAN codec null-pointer, short-frame, and 64-bit boundary checks.
+ */
+
+#include <array>
+
+#include "can_codec.hpp"
+#include "test_framework.hpp"
+
+namespace can_fixture_test {
+
+namespace {
+
+using can_fixture::Endianness;
+using can_fixture::kMaxFrameBytes;
+using can_fixture::SignalDef;
+
+/**
+ * @brief Verify packRaw and unpackRaw reject null pointers, short frames, and out-of-bounds signals.
+ * @req REQ-CODEC-006
+ */
+void testCodecBoundsAndNullChecks() {
+    std::array<std::uint8_t, kMaxFrameBytes> frameBytes{};
+    std::uint64_t rawValue = 0ULL;
+
+    const SignalDef validBoundary{56U, 8U, Endianness::Little, false, 1.0, 0.0, 0.0, 255.0};
+    const SignalDef pastBoundary{57U, 8U, Endianness::Little, false, 1.0, 0.0, 0.0, 255.0};
+    const SignalDef startOutOfBounds{64U, 1U, Endianness::Big, false, 1.0, 0.0, 0.0, 1.0};
+
+    CHECK(can_fixture::isValidSignal(validBoundary));
+    CHECK(!can_fixture::isValidSignal(pastBoundary));
+    CHECK(!can_fixture::isValidSignal(startOutOfBounds));
+
+    CHECK(!can_fixture::packRaw(pastBoundary, 1ULL, frameBytes.data(), frameBytes.size()));
+    CHECK(!can_fixture::unpackRaw(pastBoundary, frameBytes.data(), frameBytes.size(), &rawValue));
+
+    CHECK(!can_fixture::packRaw(validBoundary, 1ULL, nullptr, kMaxFrameBytes));
+    CHECK(!can_fixture::packRaw(validBoundary, 1ULL, frameBytes.data(), 7U));
+    CHECK(!can_fixture::packRaw(validBoundary, 1ULL, frameBytes.data(), 0U));
+
+    CHECK(!can_fixture::unpackRaw(validBoundary, nullptr, kMaxFrameBytes, &rawValue));
+    CHECK(!can_fixture::unpackRaw(validBoundary, frameBytes.data(), kMaxFrameBytes, nullptr));
+    CHECK(!can_fixture::unpackRaw(validBoundary, frameBytes.data(), 7U, &rawValue));
+    CHECK(!can_fixture::unpackRaw(validBoundary, frameBytes.data(), 0U, &rawValue));
+}
+
+}  // namespace
+
+REGISTER_TEST_SUITE(testCodecBoundsAndNullChecks);
+
+}  // namespace can_fixture_test
