+/**
+ * @brief Verify isRawInRange boundary checks for signed and unsigned signal definitions.
+ * @req REQ-CODEC-007
+ */
+void testIsRawInRange() {
+    const SignalDef unsignedByte{0U, 8U, Endianness::Little, false, 1.0, 0.0, 0.0, 255.0};
+    CHECK(!can_fixture::isRawInRange(unsignedByte, -1));
+    CHECK(can_fixture::isRawInRange(unsignedByte, 0));
+    CHECK(can_fixture::isRawInRange(unsignedByte, 255));
+    CHECK(!can_fixture::isRawInRange(unsignedByte, 256));
+
+    const SignalDef signedByte{0U, 8U, Endianness::Little, true, 1.0, 0.0, -128.0, 127.0};
+    CHECK(!can_fixture::isRawInRange(signedByte, -129));
+    CHECK(can_fixture::isRawInRange(signedByte, -128));
+    CHECK(can_fixture::isRawInRange(signedByte, 127));
+    CHECK(!can_fixture::isRawInRange(signedByte, 128));
+}
