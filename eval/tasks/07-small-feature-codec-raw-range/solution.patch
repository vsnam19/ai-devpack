@@ -220,4 +220,26 @@ bool decodePhysical(
     return true;
 }
 
+bool isRawInRange(const SignalDef& signal, std::int64_t candidateValue) noexcept {
+    if (!isValidSignal(signal)) {
+        return false;
+    }
+    if (!signal.isSigned) {
+        if (candidateValue < 0) {
+            return false;
+        }
+        if (signal.bitLength >= 63U) {
+            return true;
+        }
+        const std::uint64_t maxUnsigned = (1ULL << signal.bitLength) - 1ULL;
+        return static_cast<std::uint64_t>(candidateValue) <= maxUnsigned;
+    }
+    if (signal.bitLength >= static_cast<std::uint8_t>(kMaxFrameBits)) {
+        return true;
+    }
+    const std::int64_t minSigned = -(1LL << (signal.bitLength - 1U));
+    const std::int64_t maxSigned = (1LL << (signal.bitLength - 1U)) - 1LL;
+    return (candidateValue >= minSigned) && (candidateValue <= maxSigned);
+}
+
 }  // namespace can_fixture
