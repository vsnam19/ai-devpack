+bool decodeMultiplexedPhysical(
+    const SignalDef& muxSelectorSignal,
+    std::uint64_t expectedMuxValue,
+    const SignalDef& valueSignal,
+    const std::uint8_t* frameBytes,
+    double* physicalOut) noexcept {
+    if (!isValidSignal(muxSelectorSignal) || !isValidSignal(valueSignal)) {
+        return false;
+    }
+    if (muxSelectorSignal.isSigned || muxSelectorSignal.bitLength > 16U) {
+        return false;
+    }
+    if (frameBytes == nullptr || physicalOut == nullptr) {
+        return false;
+    }
+    std::uint64_t actualMux = 0ULL;
+    if (!unpackRaw(muxSelectorSignal, frameBytes, kMaxFrameBytes, &actualMux)) {
+        return false;
+    }
+    if (actualMux != expectedMuxValue) {
+        return false;
+    }
+    return decodePhysical(valueSignal, frameBytes, kMaxFrameBytes, physicalOut);
+}
+
 }  // namespace can_fixture
