+/**
+ * @file test_mux_decode.cpp
+ * @brief Unit tests for REQ-CODEC-008 multiplexed physical signal decoding.
+ */
+
+#include <array>
+
+#include "can_codec.hpp"
+#include "test_framework.hpp"
+
+namespace can_fixture_test {
+
+namespace {
+
+using can_fixture::Endianness;
+using can_fixture::kMaxFrameBytes;
+using can_fixture::SignalDef;
+
+/**
+ * @brief Verify decodeMultiplexedPhysical selector match, mismatch, and guard checks.
+ * @req REQ-CODEC-008
+ */
+void testMultiplexedSignalDecoding() {
+    std::array<std::uint8_t, kMaxFrameBytes> frameBytes{};
+    const SignalDef muxSignal{0U, 8U, Endianness::Little, false, 1.0, 0.0, 0.0, 255.0};
+    const SignalDef valueSignal{8U, 12U, Endianness::Little, true, 0.5, 0.0, -500.0, 500.0};
+    CHECK(can_fixture::packRaw(muxSignal, 5ULL, frameBytes.data(), frameBytes.size()));
+    CHECK(can_fixture::encodePhysical(valueSignal, -42.5, frameBytes.data(), frameBytes.size()));
+    double out = 123.0;
+    CHECK(!can_fixture::decodeMultiplexedPhysical(muxSignal, 4ULL, valueSignal, frameBytes.data(), &out));
+    CHECK_NEAR(out, 123.0, 1e-9);
+    CHECK(can_fixture::decodeMultiplexedPhysical(muxSignal, 5ULL, valueSignal, frameBytes.data(), &out));
+    CHECK_NEAR(out, -42.5, 1e-6);
+}
+
+}  // namespace
+
+REGISTER_TEST_SUITE(testMultiplexedSignalDecoding);
+
+}  // namespace can_fixture_test
