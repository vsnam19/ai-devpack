+/**
+ * @file test_vague_link_recovery.cpp
+ * @brief Unit tests for REQ-LINK-005 link fault heartbeat guards.
+ */
+
+#include "link_state_machine.hpp"
+#include "test_framework.hpp"
+
+namespace can_fixture_test {
+
+namespace {
+
+using can_fixture::LinkConfig;
+using can_fixture::LinkState;
+using can_fixture::LinkStateMachine;
+
+/**
+ * @brief Verify onHeartbeat is rejected in Idle, Connecting, Fault, and stale timestamps.
+ * @req REQ-LINK-005
+ */
+void testHeartbeatStateGuards() {
+    const LinkConfig config{50U, 100U, 1U};
+    LinkStateMachine machine(config);
+
+    CHECK(!machine.onHeartbeat(10ULL));
+    CHECK(machine.startConnect(100ULL));
+    CHECK(!machine.onHeartbeat(120ULL));
+    CHECK_EQ(machine.onTick(150ULL), LinkState::Connecting);
+    CHECK_EQ(machine.onTick(200ULL), LinkState::Fault);
+    CHECK(!machine.onHeartbeat(250ULL));
+    CHECK_EQ(machine.state(), LinkState::Fault);
+}
+
+}  // namespace
+
+REGISTER_TEST_SUITE(testHeartbeatStateGuards);
+
+}  // namespace can_fixture_test
