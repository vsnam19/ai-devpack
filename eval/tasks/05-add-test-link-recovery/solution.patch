+/**
+ * @file test_link_recovery.cpp
+ * @brief Unit tests for LinkStateMachine heartbeat recovery and invalid-state rejection.
+ */
+
+#include "link_state_machine.hpp"
+#include "test_framework.hpp"
+
+namespace can_fixture_test {
+
+namespace {
+
+using can_fixture::LinkConfig;
+using can_fixture::LinkState;
+using can_fixture::LinkStateMachine;
+
+/**
+ * @brief Verify Degraded recovery resets retryCount on heartbeat and invalid states reject heartbeat.
+ * @req REQ-LINK-005
+ */
+void testDegradedRecoveryAndInvalidHeartbeats() {
+    const LinkConfig config{100U, 200U, 2U};
+    LinkStateMachine machine(config);
+
+    CHECK(!machine.onHeartbeat(10ULL));
+    CHECK_EQ(machine.state(), LinkState::Idle);
+
+    CHECK(machine.startConnect(0ULL));
+    CHECK(!machine.onHeartbeat(20ULL));
+    CHECK_EQ(machine.state(), LinkState::Connecting);
+
+    CHECK(machine.onHandshakeAck(50ULL));
+    CHECK_EQ(machine.onTick(250ULL), LinkState::Degraded);
+    CHECK_EQ(machine.retryCount(), static_cast<std::uint8_t>(1U));
+    CHECK_EQ(machine.onTick(450ULL), LinkState::Degraded);
+    CHECK_EQ(machine.retryCount(), static_cast<std::uint8_t>(2U));
+
+    CHECK(machine.onHeartbeat(500ULL));
+    CHECK_EQ(machine.state(), LinkState::Active);
+    CHECK_EQ(machine.retryCount(), static_cast<std::uint8_t>(0U));
+
+    CHECK_EQ(machine.onTick(700ULL), LinkState::Degraded);
+    CHECK_EQ(machine.retryCount(), static_cast<std::uint8_t>(1U));
+    CHECK_EQ(machine.onTick(900ULL), LinkState::Degraded);
+    CHECK_EQ(machine.retryCount(), static_cast<std::uint8_t>(2U));
+    CHECK_EQ(machine.onTick(1100ULL), LinkState::Fault);
+
+    CHECK(!machine.onHeartbeat(1150ULL));
+    CHECK_EQ(machine.state(), LinkState::Fault);
+}
+
+}  // namespace
+
+REGISTER_TEST_SUITE(testDegradedRecoveryAndInvalidHeartbeats);
+
+}  // namespace can_fixture_test
