+        return false;
+    }
+    std::uint64_t selectorRaw = 0ULL;
+    if (!unpackRaw(muxSelectorSignal, frameBytes, kMaxFrameBytes, &selectorRaw)) {
+        return false;
+    }
+    if (selectorRaw != expectedMuxValue) {
+        return false;
+    }
+    return decodePhysical(valueSignal, frameBytes, kMaxFrameBytes, physicalOut);
