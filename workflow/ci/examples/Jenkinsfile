// CI-only vendored installation; provision git, Python 3.11+, clang, cppcheck and build tools.
// Optional agent stage requires DEVPACK_DIR to select an external trusted installation.
// devpack_run performs the real implement/gate/read-only-review/bounded-fix loop.
pipeline {
  agent any
  environment {
    DEVPACK_DIR = 'devpack'
    GATE_CONFIG = '.devpack/gate.toml'
    ENGINES_CONFIG = '.devpack/engines.toml'
    DEVPACK_BASE = 'origin/main'
  }
  stages {
    stage('preflight') {
      steps {
        sh 'python3 $DEVPACK_DIR/enforcement/gate/project_checks.py --check lint --base "$DEVPACK_BASE" --all-components'
      }
    }
    stage('implement and review (sandboxed)') {
      when { expression { return params.DEVPACK_TASK } }
      steps {
        sh 'python3 $DEVPACK_DIR/runner/devpack_run.py --config "$ENGINES_CONFIG" --task-file "$DEVPACK_TASK" --gate-config "$GATE_CONFIG" --all-components'
      }
    }
    stage('gate') {
      steps {
        sh 'python3 $DEVPACK_DIR/enforcement/gate/gate.py --config "$GATE_CONFIG" --all-components'
      }
    }
    stage('human approval') {
      steps {
        input message: 'Independent human reviewer approves the merge?'
      }
    }
  }
  parameters {
    string(name: 'DEVPACK_TASK', defaultValue: '', description: 'Optional brief; requires external trusted runner')
  }
}
